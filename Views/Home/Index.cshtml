
@{
    ViewData["Title"] = "Kids Fun Factory";
}

<link rel="stylesheet" href="~/css/site.css" />

<header class="navbar">
    <a class="brand" href="/">🎪 Kids Fun Factory</a>
    <nav>
        <a href="#home">Home</a>
        <a href="#games">Games</a>
        <a href="#about">About</a>
    </nav>
</header>

<main>
    <section class="hero" id="home">
        <div class="hero-content">
            <span class="welcome-tag">🌟 A World of Fun!</span>
            <h1>Welcome to <span>Kids Fun Factory!</span></h1>
            <p>
                Play, learn, explore and have amazing adventures!
                There is something fun waiting for everyone.
            </p>
            <a href="#games" class="play-button">Let's Play! 🚀</a>
        </div>
        <div class="hero-art">
            <div class="sun">☀️</div>
            <div class="rainbow">🌈</div>
            <div class="bear">🧸</div>
            <div class="star">⭐</div>
        </div>
    </section>

    <section class="games-section" id="games">
        <div class="section-heading">
            <span>🎮 PLAY TIME</span>
            <h2>Choose Your Adventure!</h2>
            <p>Three exciting games. Endless fun!</p>
        </div>

        <div class="games-grid">

            <!-- GAME 1: BALLOON POP -->
            <article class="game-card balloon-card">
                <div class="game-icon">🎈</div>
                <h3>Balloon Pop!</h3>
                <p>Pop all the colourful balloons. How many can you pop?</p>

                <div class="balloon-game">
                    <input type="checkbox" id="b1">
                    <label for="b1" class="balloon red">🎈</label>

                    <input type="checkbox" id="b2">
                    <label for="b2" class="balloon blue">🎈</label>

                    <input type="checkbox" id="b3">
                    <label for="b3" class="balloon yellow">🎈</label>

                    <input type="checkbox" id="b4">
                    <label for="b4" class="balloon green">🎈</label>

                    <input type="checkbox" id="b5">
                    <label for="b5" class="balloon purple">🎈</label>

                    <div class="score">
                        Balloons popped:
                        <span class="counter"></span>
                    </div>
                    <p class="game-message">Amazing! Keep popping! 🎉</p>
                </div>
            </article>

            <!-- GAME 2: COLOR CHALLENGE -->
            <article class="game-card color-card">
                <div class="game-icon">🌈</div>
                <h3>Color Challenge!</h3>
                <p>Can you find the correct colour? Choose your answer!</p>

                <div class="color-game">
                    <h4>Which one is RED?</h4>

                    <input type="radio" name="color" id="red-answer">
                    <label for="red-answer" class="color-option red-option">
                        🔴 Red
                    </label>

                    <input type="radio" name="color" id="blue-answer">
                    <label for="blue-answer" class="color-option blue-option">
                        🔵 Blue
                    </label>

                    <input type="radio" name="color" id="yellow-answer">
                    <label for="yellow-answer" class="color-option yellow-option">
                        🟡 Yellow
                    </label>

                    <div class="correct-message">
                        🎉 Correct! You are a colour champion!
                    </div>

                    <div class="wrong-message">
                        😊 Not quite! Try again!
                    </div>
                </div>
            </article>

            <!-- GAME 3: TREASURE HUNT -->
            <article class="game-card treasure-card">
                <div class="game-icon">🏴‍☠️</div>
                <h3>Treasure Hunt!</h3>
                <p>Three treasure chests are waiting. Find the hidden treasure!</p>

                <div class="treasure-game">
                    <h4>Choose a treasure chest!</h4>

                    <input type="radio" name="treasure" id="chest1">
                    <label for="chest1" class="chest">🎁</label>

                    <input type="radio" name="treasure" id="chest2">
                    <label for="chest2" class="chest">🎁</label>

                    <input type="radio" name="treasure" id="chest3">
                    <label for="chest3" class="chest">🎁</label>

                    <div class="treasure-win">
                        🏆 YOU FOUND THE TREASURE!
                        <p>Congratulations, little best explorer!</p>
                    </div>

                    <div class="treasure-try">
                        🙈 No treasure here! Try another chest.
                    </div>
                </div>
            </article>

        </div>
    </section>

    <section class="about-section" id="about">
        <h2>Why Kids Fun Factory? 💖</h2>
        <p>
            We believe learning should be full of laughter,
            creativity and exciting adventures!
        </p>

        <div class="features">
            <div>🧠 Learn New Things</div>
            <div>🎨 Explore Creativity</div>
            <div>🎮 Play Every Day</div>
        </div>
    </section>
</main>

<footer>
    <p>🌈 Kids Fun Factory © 2026 | Made with 💖 for little explorers!</p>
</footer>
